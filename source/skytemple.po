#: skytemple-files/skytemple_files/common/tiled_image.py:334
#: skytemple-files/skytemple_files/common/tiled_image.py:348
msgid "Can not convert PIL image to PMD tiled image: The color {pix} (from palette {math.floor(pix / single_palette_size)}) used by pixel {x+(idx % 2)}x{y} in tile {tile_id} ({tile_x}x{tile_y} is out of range. Expected are colors from palette {tile_palette_indices[tile_id]} ({tile_palette_indices[tile_id] * single_palette_size} - {(tile_palette_indices[tile_id]+1) * single_palette_size - 1})."
msgstr "无法将 PIL 图像转换为 PMD 图块图像：图块 {tile_id} ({tile_x}x{tile_y}) 中像素 {x+(idx % 2)}x{y} 使用的颜色 {pix}（来自调色板 {math.floor(pix / single_palette_size)}）超出范围。预期颜色来自调色板 {tile_palette_indices[tile_id]} ({tile_palette_indices[tile_id] * single_palette_size} - {(tile_palette_indices[tile_id]+1) * single_palette_size - 1})。"

#: skytemple-files/skytemple_files/common/tiled_image.py:394
#, python-brace-format
msgid "An image selected to import is too complex. It has too many unique tiles ({len_final_tiles}, max allowed are 1024).\n"
