#: skytemple-files/skytemple_files/patch/handler/actor_and_level_loader.py:53
msgid "Tells the game to load the actor and level lists from separate files.\n"
"Extracts both files on applying the patch."
msgstr "告诉游戏从单独的文件中加载角色和等级列表。\n应用补丁时提取这两个文件。"

#: skytemple-files/skytemple_files/patch/handler/actor_and_level_loader.py:98
msgid "This patch can not be re-applied."
msgstr "此补丁无法重新应用。"

#: skytemple-files/skytemple_files/patch/handler/actor_and_level_loader.py:104
#: skytemple-files/skytemple_files/patch/handler/actor_and_level_loader.py:112
msgid "The source data specification was not found in the configuration."
msgstr "在配置中未找到源数据规范。"

#: skytemple-files/skytemple_files/patch/handler/actor_and_level_loader.py:127
msgid "\n\n"
"The list was extracted anyway.\n"
"You can already edit it through SkyTemple, but it won't be used in game, until you successfully apply the patch."
msgstr "\n\n无论如何，列表已被提取。\n你可以通过 SkyTemple 编辑它，但在成功应用补丁之前，它不会在游戏中使用。"

#: skytemple-files/skytemple_files/patch/handler/add_key_check.py:48
msgid "Prevents Keys from being used on party members that are not below a Key Door!"
msgstr "防止钥匙在未处于钥匙门下方的队友身上使用！"

#: skytemple-files/skytemple_files/patch/handler/add_type.py:1386
msgid "Add types to the type matchup table. This will replace the old matchup table by the 6th+ Gen type table, Fairy type being added to the end."
msgstr "向属性克制表添加属性。这将用第6世代及之后的属性表替换旧的克制表，妖精属性被添加在末尾。"

#: skytemple-files/skytemple_files/patch/handler/allow_unrecruitable_mons.py:48
msgid "Allows recruiting the other Deoxys forms and the regis inside dungeons."
msgstr "允许在迷宫内招募代欧奇希斯的其他形态和神柱们。"

#: skytemple-files/skytemple_files/patch/handler/anti_softlock.py:49
msgid "Allows the player to press A+B+X+Y during cutscenes to force the game to continue past a softlock (this can happen during cutscenes when using custom sprites or the randomizer). Does not work with crashes caused due to internal errors (such as the game running out of memory)."
msgstr "允许玩家在过场动画期间按下 A+B+X+Y 强制游戏跳过软锁（这可能在过场动画中使用自定义精灵或随机化时发生）。无法处理由内部错误（例如游戏内存不足）导致的崩溃。"

#: skytemple-files/skytemple_files/patch/handler/appraise_all.py:56
msgid "Appraise all"
msgstr "全部鉴定"

#: skytemple-files/skytemple_files/patch/handler/appraise_all.py:58
msgid " And to appraise all your items, \n"
"you will pay [CS:G][gold_left:0][CR][M:S0]?"
msgstr " 要鉴定你所有的道具，\n需支付 [CS:G][gold_left:0][CR][M:S0]？"

#: skytemple-files/skytemple_files/patch/handler/appraise_all.py:62
msgid " And so...[K]it is revealed...[C] Within the boxes...[K]\n"
"were..."
msgstr " 于是...[K]揭晓了...[C] 在这些盒子中...[K]\n有..."

#. TRANSLATORS: Appraise All Reveal Before
#: skytemple-files/skytemple_files/patch/handler/appraise_all.py:65
msgid " ...a [me_play:1][string0]!"
msgstr " ...一个 [me_play:1][string0]！"

#: skytemple-files/skytemple_files/patch/handler/appraise_all.py:75
msgid "Adds an extra menu in box appraisal to appraise all boxes at once. "
msgstr "在盒子鉴定中增加一个额外菜单，可以一次性鉴定所有盒子。"

#: skytemple-files/skytemple_files/patch/handler/better_enemy_evolution.py:49
msgid "Allows changing how enemy evolution works. In particular, it allows you to choose if the evolved enemy will get the stats and/or moves from its new species, add extra stats after evolving, heal the enemy after evolving or choosing if the evolution will take place even if the target is revived."
msgstr "允许更改敌人进化的方式。具体来说，可以选择进化后的敌人是否会从新物种获得能力和/或招式、进化后是否增加额外能力、进化后是否回复HP，或者即使目标被复活也会进化。"

#: skytemple-files/skytemple_files/patch/handler/bold_text.py:48
msgid "Adds new text tags that allow for bold text in strings. Encase the desired text with [BS] and [BR]."
msgstr "添加新的文本标签，可以在字符串中使用粗体文本。用 [BS] 和 [BR] 包裹所需文本。"

#: skytemple-files/skytemple_files/patch/handler/change_evo.py:118
msgid "Change the evolution system.\n"
"After applying this, every single Pokémon will have two lists for their evolution and children, and different stat bonuses when a Pokémon evolves into them.\n"
"This supposedly removes most of the particular cases the game handles for evolutions. "
msgstr "更改进化系统。\n应用此补丁后，每只宝可梦将拥有两个列表用于进化和子代，并在进化成它们时获得不同的能力加成。\n这据说移除了游戏处理进化时的大多数特殊情况。"

#: skytemple-files/skytemple_files/patch/handler/change_evo.py:209
#, python-brace-format
msgid "Infinite recursion detected in pre evolutions for md entry {i}. "
msgstr "在 md 条目 {i} 的前进化中检测到无限递归。"

#: skytemple-files/skytemple_files/patch/handler/change_evo.py:216
#, python-brace-format
msgid "One of the monsters in the pre-evolution chain of monster ${i:04} has an invalid pre evolution configured: ${pre_evo:04}. Can not apply patch."
msgstr "宝可梦 ${i:04} 的前进化链中的某一只宝可梦配置了无效的前进化：${pre_evo:04}。无法应用补丁。"

#: skytemple-files/skytemple_files/patch/handler/change_ff_prop.py:52
msgid "Changes and adds some properties for fixed floors.\n"
"Removes restrictions. "
msgstr "更改并添加固定楼层的一些属性。\n移除限制。"

#: skytemple-files/skytemple_files/patch/handler/change_portrait.py:49
msgid "Implements the text tag [FACE:X], which sets the current portrait to use the Xth portrait emotion (e.g. 0 = FACE_NORMAL).\n"
"This allows for changing portrait emotions during dialogue!"
msgstr "实现文本标签 [FACE:X]，将当前肖像设置为使用第 X 种肖像表情（例如 0 = FACE_NORMAL）。\n这允许在对话中更改肖像表情！"

#: skytemple-files/skytemple_files/patch/handler/change_tbbg.py:48
msgid "Provides support for editing textbox background color."
msgstr "提供对编辑文本框背景颜色的支持。"

#: skytemple-files/skytemple_files/patch/handler/change_text_sound.py:51
msgid "Adds new text tags that allow for the textbox sound to be changed. [TS:X:Y] will use the Xth sound effect ID in textboxes with a volume of Y. [TR] will revert the sound and volume to their default states, sound effect 16133 and volume 256."
msgstr "添加新的文本标签，允许更改文本框音效。[TS:X:Y] 将在文本框中使用第 X 个音效 ID，音量为 Y。[TR] 将恢复音效和音量至默认状态，即音效 16133 和音量 256。"

#: skytemple-files/skytemple_files/patch/handler/choose_starter.py:55
msgid "Then, who would you like to be?"
msgstr "那么，你想成为谁？"

#: skytemple-files/skytemple_files/patch/handler/choose_starter.py:65
msgid "Adds an extra menu during the personality test to choose the starter."
msgstr "在性格测试期间增加一个额外菜单，用于选择初始宝可梦。"

#: skytemple-files/skytemple_files/patch/handler/complete_team_control.py:105
msgid "[CS:S]Control mode set to[CR] [CS:C]automatic[CR][CS:S].[CR]"
msgstr "[CS:S]控制模式已设置为[CR] [CS:C]自动[CR][CS:S]。[CR]"

#: skytemple-files/skytemple_files/patch/handler/complete_team_control.py:108
msgid "[CS:S]Control mode set to[CR] [CS:E]manual[CR][CS:S].[CR]"
msgstr "[CS:S]控制模式已设置为[CR] [CS:E]手动[CR][CS:S]。[CR]"

#: skytemple-files/skytemple_files/patch/handler/complete_team_control.py:120
msgid "Pressing start in a dungeon toggles between automatic and manual mode. In manual mode, you can control your partners on their turns. You must apply the extra code overlay made by Frostbyte before applying this patch."
msgstr "在迷宫中按 Start 键可在自动和手动模式之间切换。在手动模式下，你可以在伙伴的回合控制它们。应用此补丁前，你必须先应用 Frostbyte 制作的额外代码覆盖。"

#: skytemple-files/skytemple_files/patch/handler/compress_iq_data.py:50
msgid "Optimizes the way the list of IQ skills learnt by each IQ group is stored, removing the limit of max 25 skills per group."
msgstr "优化每个 IQ 组学习的 IQ 技能列表的存储方式，移除每组最多 25 个技能的限制。"

#: skytemple-files/skytemple_files/patch/handler/disable_tips.py:48
msgid "Disables the tip textboxes shown in dungeons at the beginning of the game."
msgstr "禁用在游戏初期迷宫中显示的提示文本框。"

#: skytemple-files/skytemple_files/patch/handler/disarm_one_room_mh.py:44
msgid "Disarms one-room Monster House floors, which can appear in cases like a layout generation failure. These floors will still be one giant room, but will no longer be Monster Houses."
msgstr "解除单房间怪兽屋楼层（可能在布局生成失败等情况下出现）。这些楼层仍将是一个大房间，但不再是怪兽屋。"

#: skytemple-files/skytemple_files/patch/handler/display_script_var.py:49
msgid "Displays a script variable in a string with the text tag [var:x:y], where \"x\" is the variable ID and \"y\" is the index!"
msgstr "使用文本标签 [var:x:y] 在字符串中显示脚本变量，其中“x”是变量 ID，“y”是索引！"

#: skytemple-files/skytemple_files/patch/handler/dungeon_interrupt.py:50
msgid "Implements dungeon interruptions. "
msgstr "实现迷宫中断。"

#: skytemple-files/skytemple_files/patch/handler/dynamic_bosses_everywhere.py:49
msgid "Allows placing special fixed room entities #124-127 (Explorer Maze enemies) in any fixed room without causing the game to crash."
msgstr "允许将特殊固定房间实体 #124-127（探险迷宫敌人）放置在任何固定房间中，而不会导致游戏崩溃。"

#: skytemple-files/skytemple_files/patch/handler/edit_guest_pokemon.py:49
msgid "Changes the way the game determines when to add guest pokémon to the team so it can be edited more easily"
msgstr "更改游戏决定何时将客串宝可梦加入队伍的方式，以便更容易编辑"

#: skytemple-files/skytemple_files/patch/handler/exp_share.py:59
msgid "Implements shared experience points between all members (GtI style). \n"
"This is disabled during Special Episodes and dungeons with level 1 or no exp. restrictions. \n"
"Needs the ExtractDungeonData patch to be applied to free some space used by this."
msgstr "实现全队成员共享经验值（GtI 风格）。\n在特殊剧情和等级1或无经验限制的迷宫中禁用。\n需要先应用 ExtractDungeonData 补丁以释放一些空间。"

#: skytemple-files/skytemple_files/patch/handler/expand_poke_list.py:115
msgid "Expand the pokemon entries allowed to 2048, and makes all the entries independent.\n"
"Needs ChangeEvoSystem, ExternalizeWazaFile, ExternalizeMappaFile, SpriteSizeInMonsterData patches to work.\n"
"It is strongly recommended to fix any dungeon error before applying this patch,\n"
"and to save a backup of your ROM before applying this."
msgstr "将宝可梦条目扩展至 2048，并使所有条目独立。\n需要 ChangeEvoSystem、ExternalizeWazaFile、ExternalizeMappaFile、SpriteSizeInMonsterData 补丁才能工作。\n强烈建议在应用此补丁前修复所有迷宫错误，\n并在应用前备份你的 ROM。"

#: skytemple-files/skytemple_files/patch/handler/expand_portrait.py:48
msgid "Expands portraits structure by 8 bytes, which is enough to cover all cases."
msgstr "将肖像结构扩展 8 字节，这足以涵盖所有情况。"

#: skytemple-files/skytemple_files/patch/handler/externalize_mappa.py:49
msgid "Use filestreams to access mappa_t/mappa_y/mappa_s data instead of loading them entirely.\n"
"This patch is useless on its own, unless you have a too big mappa file."
msgstr "使用文件流访问 mappa_t/mappa_y/mappa_s 数据，而不是全部加载。\n此补丁本身无用，除非你的 mappa 文件过大。"

#: skytemple-files/skytemple_files/patch/handler/externalize_waza.py:49
msgid "Use filestreams to access waza_p/waza_p2 data instead of loading them entirely.\n"
"This patch is useless on its own.\n"
"Depends on the ActorAndLevelLoader patch, as it needs some space provided by this one."
msgstr "使用文件流访问 waza_p/waza_p2 数据，而不是全部加载。\n此补丁本身无用。\n依赖于 ActorAndLevelLoader 补丁，因为它需要后者提供的一些空间。"

#: skytemple-files/skytemple_files/patch/handler/extra_space.py:50
msgid "This patch adds a new overlay 36 to the game, which is loaded at address 0x023A7080 and provides extra space for patches to place code and data in."
msgstr "此补丁向游戏添加一个新的 overlay 36，加载到地址 0x023A7080，为补丁提供额外空间来存放代码和数据。"

#: skytemple-files/skytemple_files/patch/handler/extract_anims.py:55
msgid "Extracts animation data and put it in files. \n"
"Needs ActorAndLevelLoader patch to free some space. "
msgstr "提取动画数据并将其放入文件。\n需要 ActorAndLevelLoader 补丁来释放一些空间。"

#: skytemple-files/skytemple_files/patch/handler/extract_bar_list.py:66
msgid "Extracts Spinda bar's item list."
msgstr "提取晃晃斑果汁馆的道具列表。"

#: skytemple-files/skytemple_files/patch/handler/extract_dungeon_data.py:177
msgid "Extracts the floor ranks, forbidden mission floors, items available in dungeon tables and put them in files. Provides support for reading them from the rom file system."
msgstr "提取楼层等级、禁止任务楼层、迷宫中可用的道具表，并将它们放入文件。提供从 ROM 文件系统读取它们的支持。"

#: skytemple-files/skytemple_files/patch/handler/extract_item_code.py:77
msgid "Extracts item effects code and put it in files."
msgstr "提取道具效果代码并将其放入文件。"

#: skytemple-files/skytemple_files/patch/handler/extract_item_lists.py:65
msgid "Extracts the hardcoded item lists, used for mission rewards/treasure boxes content as well as Kecleon shop items, and put them in files. Provides support for reading them from the rom file system."
msgstr "提取硬编码的道具列表，用于任务奖励/宝箱内容以及变隐龙商店道具，并将它们放入文件。提供从 ROM 文件系统读取它们的支持。"

#: skytemple-files/skytemple_files/patch/handler/extract_item_lists.py:139
msgid "Don't have enough space to put filenames! "
msgstr "没有足够空间放置文件名！"

#: skytemple-files/skytemple_files/patch/handler/extract_move_code.py:80
msgid "Extracts move effects code and put it in files."
msgstr "提取招式效果代码并将其放入文件。"

#: skytemple-files/skytemple_files/patch/handler/extract_sp_code.py:72
msgid "Extracts special processes code and put it in files."
msgstr "提取特殊处理代码并将其放入文件中。"

#: skytemple-files/skytemple_files/patch/handler/fairy_gummies.py:113
msgid "Implements Fairy-type specialized gummies. Uses unused item 138.\n"
"Needs ExtractItemCode, ExtractBarItemList and AddTypes patches to be applied for this patch to work.\n"
"Also, you'll need to reapply this if you apply AddTypes again. "
msgstr "实现妖精属性专用软糖。使用未使用的道具 138。\n需要先应用 ExtractItemCode、ExtractBarItemList 和 AddTypes 补丁，此补丁才能工作。\n此外，如果你再次应用 AddTypes，你需要重新应用此补丁。"

#: skytemple-files/skytemple_files/patch/handler/far_off_pal_overdrive.py:50
msgid "Makes the game always move the PoV to your partners when they use moves or are attacked, even if the partner is only one tile away, when far-off pals is enabled. Recommended for CTC since the PoV stays on your last pokemon at the end of a manual movement round without this, and CTC already reduces the amount of time the game pauses for between PoV changes."
msgstr "当启用远友视角时，让游戏始终将视角移至正在使用招式或受到攻击的伙伴，即使伙伴仅在一格外。建议与 CTC 搭配使用，因为没有此补丁时，在手动移动回合结束时视角会停留在最后一只宝可梦上，而 CTC 已经减少了视角切换之间的停顿时间。"

#: skytemple-files/skytemple_files/patch/handler/fast_chimecho.py:47
msgid "Shorten Chimecho Team Assembly menu interactions. Adding, removing and making leader are now fast interactions that immediately go back to the team member selection menu."
msgstr "缩短风铃铃组队菜单的交互。添加、移除和设为领队现在都是快速操作，会立即返回队员选择菜单。"

#: skytemple-files/skytemple_files/patch/handler/fix_evolution.py:45
msgid "Fixes the evolution glitch that freezes the game when attempting to evolve a pokémon whose name has 10 characters."
msgstr "修复一个进化故障：当尝试进化名字长度为 10 个字符的宝可梦时，游戏会卡死。"

#: skytemple-files/skytemple_files/patch/handler/fix_memory_softlock.py:47
msgid "If the game runs out of memory trying to load a sprite, a default one will be used instead, preventing the crash."
msgstr "如果游戏在尝试加载精灵时内存不足，将使用默认精灵，从而防止崩溃。"

#: skytemple-files/skytemple_files/patch/handler/fix_nocash_saves.py:52
msgid "Fixes an issue that causes saving to fail on the No$GBA emulator."
msgstr "修复一个导致在 No$GBA 模拟器上保存失败的问题。"

#: skytemple-files/skytemple_files/patch/handler/move_growth.py:177
msgid "Implements move growth (PoC/Unfinished). \n"
"Needs ActorAndLevelLoader, ExtractAnimData and ChangeMoveStatsDisplay patches. \n"
"MoveGrowth patch must be (re-)applied after MoveShortcuts to combine both effects. \n"
"The last version of ChangeMoveStatsDisplay must be used with this.\n"
"May be incompatible if markfont.dat has been modified (except for ChangeMoveStatsDisplay)\n"
"Makes all prior save files incompatible. "
msgstr "实现招式成长（概念验证/未完成）。\n需要 ActorAndLevelLoader、ExtractAnimData 和 ChangeMoveStatsDisplay 补丁。\nMoveGrowth 补丁必须在 MoveShortcuts 之后（重新）应用以结合两者效果。\n必须使用最新版本的 ChangeMoveStatsDisplay。\n如果 markfont.dat 已被修改（除了 ChangeMoveStatsDisplay），可能不兼容。\n使所有之前的存档不兼容。"

#: skytemple-files/skytemple_files/patch/handler/move_shortcuts.py:49
msgid "Replaces the fixed move (L+A) with a move shortcut functionality like in GtI or Super (L+A/B/X/Y). The ExtraSpace patch must be applied before this one."
msgstr "用类似 GtI 或超级中的招式快捷功能（L+A/B/X/Y）替换固定招式（L+A）。必须先应用 ExtraSpace 补丁。"

#: skytemple-files/skytemple_files/patch/handler/negative_enemy_density.py:49
msgid "Makes negative enemy density values work as intended (the absolute value of the density is used, without adding a random variation)."
msgstr "使负的敌人密度值按预期工作（使用密度的绝对值，不添加随机变化）。"

#: skytemple-files/skytemple_files/patch/handler/no_weather_stop.py:50
msgid "Changes weather damage messages so they don't make the player stop running."
msgstr "更改天气伤害消息，使其不会导致玩家停止跑步。"

#: skytemple-files/skytemple_files/patch/handler/obj_table.py:68
msgid "Extracts the object table to a separate file in the ROM."
msgstr "将对象表提取到 ROM 中的一个单独文件。"

#: skytemple-files/skytemple_files/patch/handler/partners_trigger_hidden_traps.py:50
msgid "Recommended for CTC. Without this patch, partners cannot trigger hidden traps - this balances the game, as making your partners dodge traps with manual movement is easy, but this patch is not recommended for mods which use pitfall traps, as they instakill partners which step on them."
msgstr "建议与 CTC 配合使用。没有此补丁，伙伴无法触发隐藏陷阱——这平衡了游戏，因为用手动移动让伙伴躲避陷阱很容易，但不建议在使用落穴陷阱的 Mod 中使用此补丁，因为它们会秒杀踩上去的伙伴。"

#: skytemple-files/skytemple_files/patch/handler/pitfall_trap_tweak.py:49
msgid "Makes Pitfall Traps send the leader back by one floor in ascending dungeons. If the leader activates a Pitfall Trap on 1F, they will restart 1F with a different seed."
msgstr "使落穴陷阱在向上攀爬的迷宫中将领队送回上一层。如果领队在 1F 触发了落穴陷阱，他们将以不同的种子重开 1F。"

#: skytemple-files/skytemple_files/patch/handler/pkmn_ground_anim.py:62
msgid "Changes implementation of idle animation to an editable table."
msgstr "将待机动画的实现更改为可编辑的表格。"

#: skytemple-files/skytemple_files/patch/handler/push_allies.py:44
msgid "[string:0] pushed [string:1]!"
msgstr "[string:0] 推了 [string:1]！"

#: skytemple-files/skytemple_files/patch/handler/push_allies.py:55
msgid "Implements pushing allies in dungeons.\n"
"Uses the same command style as PSMD"
msgstr "实现在迷宫中推动同伴。\n使用与 PSMD 相同的指令风格。"

#: skytemple-files/skytemple_files/patch/handler/reduce_jumpcut_pause_time.py:50
msgid "Reduces the amount of time the game pauses for before changing the PoV, like when far-off pals is enabled, from 60 frames to 12. This is already applied in the CTC hack."
msgstr "减少游戏在切换视角前的停顿时间（例如启用远友视角时），从 60 帧减少到 12 帧。这已在 CTC hack 中应用。"

#: skytemple-files/skytemple_files/patch/handler/remove_body_size_check.py:48
msgid "Removes the total body size check before entering a dungeon."
msgstr "移除进入迷宫前的总体型大小检查。"

#: skytemple-files/skytemple_files/patch/handler/same_type_partner.py:48
msgid "Allows the partner to be of the same type as the player in the personality test."
msgstr "允许在性格测试中伙伴与玩家拥有相同属性。"

#: skytemple-files/skytemple_files/patch/handler/skip_quiz.py:47
msgid "Who would you like to be?"
msgstr "你想成为谁？"

#: skytemple-files/skytemple_files/patch/handler/skip_quiz.py:58
msgid "Skips the quiz, only leaving the gender question.\n"
"Needs ChooseStarter patch to be applied. "
msgstr "跳过测验，只保留性别问题。\n需要应用 ChooseStarter 补丁。"

#: skytemple-files/skytemple_files/patch/handler/sprite_size.py:49
msgid "Changes Sprite Size and Sprite File Size values to be in each Pokémon's data."
msgstr "将精灵大小和精灵文件大小值移至每只宝可梦的数据中。"

#: skytemple-files/skytemple_files/patch/handler/stat_disp.py:69
msgid "Replaces old move stats display with bars.\n"
"This patch may not be compatible if the markfont.dat file has been modified."
msgstr "用条形图替换旧的招式统计显示。\n如果 markfont.dat 文件已被修改，此补丁可能不兼容。"

#: skytemple-files/skytemple_files/patch/handler/support_atupx.py:51
msgid "Provide support for ATUPX containers, which use a different algorithm than PX compression.\n"
"Requires the ActorAndLevelLoader, as it frees the space needed to implement this."
msgstr "提供对 ATUPX 容器的支持，该容器使用与 PX 压缩不同的算法。\n需要 ActorAndLevelLoader，因为它释放了实现此功能所需的空间。"

#: skytemple-files/skytemple_files/patch/handler/team_stats_pain.py:51
msgid "If available, change a team member's portrait in the Team Stats menu to pain when in critical condition."
msgstr "如果可用，在队伍统计菜单中将状态危急的队员的肖像更改为痛苦表情。"

#: skytemple-files/skytemple_files/patch/handler/unused_dungeon_chance.py:49
msgid "Fixes the 'unused' chance for dungeons. It now determines a chance of spawning a wall maze room in the floor."
msgstr "修复迷宫的“未使用”几率。现在它决定在楼层中生成墙壁迷宫房间的几率。"

